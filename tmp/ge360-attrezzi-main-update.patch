+body.v29-ui #appMenuDialog.v29-sheet .dialog-header{position:sticky;top:0;z-index:2;margin:-16px -14px 10px;padding:16px 14px 10px;background:var(--panel);border-radius:var(--v29-sheet-radius) var(--v29-sheet-radius) 0 0}
+body.v29-ui #appMenuDialog.v29-sheet .menu-action-list{gap:7px}
+body.v29-ui #appMenuDialog.v29-sheet .menu-action-list button{min-height:61px;border-radius:14px}
+
+/* Large controls remain large; secondary copy gets out of the way on small phones. */
+@media(max-width:520px){
+  body.v29-ui main{padding-left:11px;padding-right:11px}
+  body.v29-ui .brand-copy span{display:none}
+  body.v29-ui .sync-status-compact{max-width:112px}
+  body.v29-ui .today-status-card{padding:11px}
+  body.v29-ui .today-status-icon{width:44px;height:44px}
+  body.v29-ui .page-heading .save-status{display:none}
+  body.v29-ui .bottom-nav .nav-item strong{font-size:.62rem}
+  body.v29-ui .bottom-nav .nav-item small{display:none}
