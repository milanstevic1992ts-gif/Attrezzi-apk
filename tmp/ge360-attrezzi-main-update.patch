new file mode 100644
--- /dev/null
+++ b/public/layout-v291.js
@@ -0,0 +1,143 @@
+(() => {
+  'use strict';
+
+  const UI_VERSION = '2.9.1';
+  const APP_VERSION = '2.8.3';
+  const CALENDAR_KEY = 'edil-attrezzi-ui-v29-calendar-open';
+  let calendarOpen = false;
+
+  const setText = (node, value) => {
+    if (node && node.textContent !== value) node.textContent = value;
+  };
+
+  const readBool = (key, fallback = false) => {
+    try {
+      const value = localStorage.getItem(key);
+      return value === null ? fallback : value === '1';
+    } catch { return fallback; }
+  };
+
+  const writeBool = (key, value) => {
+    try { localStorage.setItem(key, value ? '1' : '0'); } catch {}
+  };
+
+  function versionLabels() {
+    const title = `Edil Attrezzi ${APP_VERSION}`;
+    if (document.title !== title) document.title = title;
+    document.documentElement.dataset.layoutUi = '2.9';
+    document.body.classList.add('v29-ui');
+    setText(document.querySelector('.menu-version'), `Edil Attrezzi ${APP_VERSION} · UI 2.9 · funziona anche offline`);
+    setText(document.querySelector('#view-more .more-info-card strong'), `Edil Attrezzi ${APP_VERSION}`);
+    setText(document.querySelector('#view-more .page-heading .count-badge'), 'UI 2.9');
+    document.querySelectorAll('.v24-ui-badge').forEach(node => setText(node, 'UI 2.9'));
+  }
+
+  function addMoreNav() {
+    const nav = document.querySelector('.bottom-nav');
+    if (!nav || nav.querySelector('.v29-more-nav')) return;
+    const dialog = document.getElementById('appMenuDialog');
+    dialog?.classList.add('v29-sheet');
+
+    const button = document.createElement('button');
+    button.className = 'nav-item v29-more-nav';
+    button.type = 'button';
+    button.setAttribute('aria-label', 'Apri altro, backup e impostazioni');
+    button.innerHTML = '<span aria-hidden="true">☰</span><strong>Altro</strong>';
+    nav.appendChild(button);
+
+    button.addEventListener('click', event => {
+      event.preventDefault();
+      event.stopPropagation();
+      if (dialog?.open) return dialog.close();
+      document.getElementById('appMenuBtn')?.click();
+      if (dialog?.open) button.classList.add('active');
+    });
+    dialog?.addEventListener('close', () => button.classList.remove('active'));
+    dialog?.addEventListener('cancel', () => button.classList.remove('active'));
+  }
+
+  function calendarLabel() {
+    return document.getElementById('homeCalendarTitle')?.textContent?.trim() || 'Calendario del mese';
+  }
+
+  function drawCalendarDisclosure() {
+    const card = document.getElementById('homeCalendarCard');
+    const launch = document.getElementById('v29CalendarLaunch');
+    if (!card || !launch) return;
+    card.classList.toggle('v29-collapsed', !calendarOpen);
+    launch.setAttribute('aria-expanded', String(calendarOpen));
+    setText(
+      launch.querySelector('.v29-calendar-copy small'),
+      calendarOpen ? 'Tocca per chiudere il calendario' : `${calendarLabel()} · tocca per aprire`
+    );
+  }
+
+  function addCalendarDisclosure() {
+    const card = document.getElementById('homeCalendarCard');
+    if (!card || document.getElementById('v29CalendarLaunch')) return;
+    calendarOpen = readBool(CALENDAR_KEY, false);
+
+    const launch = document.createElement('button');
+    launch.id = 'v29CalendarLaunch';
+    launch.className = 'v29-calendar-launch';
+    launch.type = 'button';
+    launch.setAttribute('aria-controls', 'homeCalendarCard');
+    launch.innerHTML = '<span aria-hidden="true">🗓️</span><span class="v29-calendar-copy"><strong>Calendario</strong><small></small></span><span class="v29-chevron" aria-hidden="true">⌄</span>';
+    card.insertAdjacentElement('beforebegin', launch);
+
+    launch.addEventListener('click', () => {
+      calendarOpen = !calendarOpen;
+      writeBool(CALENDAR_KEY, calendarOpen);
+      drawCalendarDisclosure();
+      if (calendarOpen) requestAnimationFrame(() => card.scrollIntoView({ block:'nearest', behavior:'smooth' }));
+    });
+
+    const title = document.getElementById('homeCalendarTitle');
+    if (title && window.MutationObserver) new MutationObserver(drawCalendarDisclosure).observe(title, { childList:true, subtree:true });
+    drawCalendarDisclosure();
+  }
+
+  function simplifyAgenda() {
+    const metrics = document.querySelector('.day-metrics');
+    if (!metrics) return;
+    metrics.setAttribute('aria-label', 'Vista della giornata');
+    metrics.setAttribute('role', 'tablist');
+    metrics.querySelectorAll('[data-day-tab]').forEach(button => {
+      button.setAttribute('role', 'tab');
+      const label = button.querySelector('small')?.textContent?.trim();
+      if (label) button.setAttribute('aria-label', `Apri ${label.toLowerCase()} del giorno`);
+    });
+  }
+
+  function improveInputs() {
+    ['toolSearch','materialSearch','settingsCatalogSearch'].forEach(id => {
+      const input = document.getElementById(id);
+      if (!input) return;
+      input.setAttribute('enterkeyhint', 'search');
+      input.setAttribute('autocapitalize', 'none');
+    });
+    const notes = document.getElementById('jobNotes');
+    notes?.setAttribute('spellcheck', 'true');
+    notes?.setAttribute('enterkeyhint', 'enter');
+  }
+
+  function keepJobTabVisible(event) {
+    const button = event.target.closest('.job-context-tabs button');
+    if (!button) return;
+    requestAnimationFrame(() => button.scrollIntoView({ block:'nearest', inline:'center', behavior:'smooth' }));
+  }
+
+  function init() {
+    versionLabels();
+    addMoreNav();
+    addCalendarDisclosure();
+    simplifyAgenda();
+    improveInputs();
+    document.addEventListener('click', keepJobTabVisible, { passive:true });
+    setTimeout(versionLabels, 250);
+    setTimeout(versionLabels, 1000);
+  }
+
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once:true });
+  else init();
+})();
