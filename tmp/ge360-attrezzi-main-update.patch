diff --git a/public/layout-v29.css b/public/layout-v29.css
new file mode 100644
--- /dev/null
+++ b/public/layout-v29.css
@@ -0,0 +1,123 @@
+/* GE360 Attrezzi — Layout v2.9
+   Mobile-first usability layer. No storage/cloud/business logic changes. */
+
+:root{
+  --v29-touch:52px;
+  --v29-nav-height:76px;
+  --v29-sheet-radius:24px;
+  --v29-fast-shadow:0 4px 16px rgba(23,23,23,.055);
+}
+
+html[data-layout-ui="2.9"]{scroll-padding-top:76px}
+body.v29-ui main{padding-top:14px;padding-bottom:calc(104px + env(safe-area-inset-bottom))}
+body.v29-ui .content-section{margin-top:18px}
+body.v29-ui .page-heading{margin-bottom:12px}
+body.v29-ui .page-heading h1{font-size:clamp(1.42rem,5vw,1.72rem)}
+body.v29-ui .page-heading p{line-height:1.35}
+
+/* Top bar: less chrome, more room for the actual job. */
+body.v29-ui #appMenuBtn{display:none!important}
+body.v29-ui .topbar{min-height:62px;padding-top:8px;padding-bottom:8px}
+body.v29-ui .brand-mark{width:42px;height:42px}
+body.v29-ui .sync-status-compact{min-height:40px}
+
+/* Home: the monthly calendar is useful, but it no longer owns the first screen. */
+.v29-calendar-launch{
+  display:grid;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:10px;
+  width:100%;min-height:62px;margin:0 0 12px;padding:8px 10px;border:1px solid var(--border);
+  border-radius:17px;background:var(--panel);color:var(--text);text-align:left;box-shadow:var(--v29-fast-shadow)
+}
+.v29-calendar-launch>span:first-child{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--panel-soft);font-size:1.25rem}
+.v29-calendar-launch strong,.v29-calendar-launch small{display:block;min-width:0}
+.v29-calendar-launch strong{font-size:.94rem}
+.v29-calendar-launch small{margin-top:2px;color:var(--muted);font-size:.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.v29-calendar-launch .v29-chevron{font-size:1.25rem;color:var(--muted);transition:transform .16s ease}
+.v29-calendar-launch[aria-expanded="true"] .v29-chevron{transform:rotate(180deg)}
+#homeCalendarCard.v29-collapsed{display:none!important}
+body.v29-ui .home-calendar-card{margin-top:-2px;box-shadow:none}
+
+/* Quick actions should scan like buttons, not like three miniature forms. */
+body.v29-ui .today-actions{display:flex;gap:9px;overflow-x:auto;margin:0 -2px 16px;padding:2px;scroll-snap-type:x proximity;scrollbar-width:none}
+body.v29-ui .today-actions::-webkit-scrollbar{display:none}
+body.v29-ui .today-action{flex:1 0 150px;min-width:150px;min-height:76px;scroll-snap-align:start;box-shadow:var(--v29-fast-shadow)}
+
+/* Agenda had two separate controls for the same three panes. Keep the metric row only. */
+body.v29-ui #dailyTabs{display:none!important}
+body.v29-ui .day-metrics{margin-bottom:12px;gap:6px}
+body.v29-ui .day-metric{min-height:64px;border-radius:15px}
+body.v29-ui .day-metric.active{outline:2px solid rgba(239,125,0,.22);outline-offset:1px}
+body.v29-ui .schedule-panel.daily-agenda{padding-bottom:12px}
+
+/* Job screen: v2.4 already simplified the flow; v2.9 makes it denser without shrinking touch targets. */
+body.v29-ui.v24-job-mode #view-job .job-quick-actions{gap:8px}
+body.v29-ui.v24-job-mode #view-job .job-quick-actions>button{min-height:70px;padding:8px 12px;border-radius:16px;box-shadow:var(--v29-fast-shadow)}
+body.v29-ui.v24-job-mode #view-job .job-quick-actions>button>span{width:48px;height:48px;border-radius:14px;font-size:1.55rem}
+body.v29-ui .v24-job-secondary-actions{margin-top:9px}
+body.v29-ui .v24-job-secondary-actions button{min-height:50px}
+
+/* Notes: treat them like a real field notebook. */
+body.v29-ui.v24-notes-mode #view-job .v24-notepad{padding:12px;border-radius:18px}
+body.v29-ui.v24-notes-mode #jobNotes{min-height:min(42dvh,390px);padding:15px 16px;font-size:1.06rem;line-height:1.58}
+body.v29-ui.v24-notes-mode #view-job .reminder-panel{padding:12px;border-radius:18px}
+body.v29-ui.v24-notes-mode #view-job .reminder-entry .text-input{font-size:16px}
+
+/* Tool/material selection: thumb-friendly cards with less visual noise. */
+body.v29-ui.v24-tools-mode #view-tools .sticky-filter,
+body.v29-ui.v24-materials-mode #view-materials .sticky-filter{position:sticky;top:62px;z-index:34;padding:5px 0 8px;background:linear-gradient(var(--bg) 88%,rgba(243,243,241,0))}
+body.v29-ui.v24-tools-mode #view-tools .search-box,
+body.v29-ui.v24-materials-mode #view-materials .search-box{min-height:54px;border-radius:16px;background:#fff}
+body.v29-ui.v24-tools-mode #view-tools .item-card,
+body.v29-ui.v24-materials-mode #view-materials .item-card{content-visibility:auto;contain-intrinsic-size:80px;box-shadow:0 2px 9px rgba(23,23,23,.035)}
+body.v29-ui.v24-tools-mode #view-tools .item-card{min-height:76px}
+body.v29-ui .v24-frequent-tool{min-height:96px}
+body.v29-ui .v24-frequent-scroll{scroll-snap-type:x proximity}
+body.v29-ui .v24-frequent-tool{scroll-snap-align:start}
+body.v29-ui #toolList,
+body.v29-ui #materialList{-webkit-overflow-scrolling:touch}
+
+/* Horizontal job tabs never get crushed into unreadable 4-column labels. */
+body.v29-ui .job-context-tabs{display:flex;overflow-x:auto;gap:5px;padding:4px;scrollbar-width:none}
+body.v29-ui .job-context-tabs::-webkit-scrollbar{display:none}
+body.v29-ui .job-context-tabs button{flex:0 0 auto;min-width:88px;padding:0 11px;font-size:.78rem}
+
+/* Five primary destinations. 'Altro' opens the menu as a bottom sheet. */
+body.v29-ui .bottom-nav.four-nav{grid-template-columns:repeat(5,minmax(0,1fr));padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
