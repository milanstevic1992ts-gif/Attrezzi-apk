+}
+
+@media(prefers-reduced-motion:reduce){
+  body.v29-ui *,body.v29-ui *::before,body.v29-ui *::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}
+}
